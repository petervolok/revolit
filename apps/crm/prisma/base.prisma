// Настройки подключения. Модели приходят из ядра и модулей —
// итоговый файл schema.prisma собирается скриптом scripts/build-schema.js
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
