{
  "name": "@revolit/crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run schema && next build",
    "start": "next start",
    "schema": "node scripts/build-schema.js",
    "prisma:generate": "npm run schema && prisma generate",
    "prisma:migrate": "npm run schema && prisma migrate dev",
