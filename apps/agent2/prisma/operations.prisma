// Журнал выполненных операций агента №2 (Р-45). Запись делается В ТОЙ ЖЕ транзакции, что и
// сама операция: если запись есть — операция выполнена, повторная доставка команды не
// исполняет её снова, а берёт сохранённый ответ и изменения. Живёт только в БД №2.
model OperationLog {
  // operationId = correlationId исходной команды
  id        String   @id
  // Ответ вызвавшему приложению (BusResponse в виде JSON)
  response  Json
  // Изменения для применения в БД №1 (DataChange[]); пусто — всё скрыто или нечего применять
  changes   Json
  // Доменные события, которые публикуются после подтверждения применения
  events    Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}
