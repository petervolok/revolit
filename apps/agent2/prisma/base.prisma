// Свой генератор с отдельным путём вывода — чтобы не затирать клиент apps/crm
// в общей node_modules монорепозитория (оба собираются на одной машине в CI/dev).
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output        = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
