generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Бизнес-процесс: корневой граф этапов
model Workflow {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  rootGraph Json     @default("{\"nodes\":[],\"edges\":[]}") // этапы + рёбра
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages Stage[]
  runs   WorkflowRun[]
}

// Один этап процесса — хранит свой вложенный холст (рабочие места + блоки действия)
model Stage {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nodeId     String // id ноды этапа в Workflow.rootGraph
  name       String
  subGraph   Json     @default("{\"nodes\":[],\"edges\":[]}") // рабочие места + блоки действия + рёбра
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([workflowId, nodeId])
}

// Библиотека типовых рабочих мест
model WorkstationTemplate {
  id                String @id @default(cuid())
  key               String @unique
  name              String
  defaultRegulation String // регламент по умолчанию
  defaultSkill      String // описание скила по умолчанию
  executorType      String // human | ai | both
}

// Библиотека блоков действия — типовой функционал с привязкой к бэкенду/фронтенду
model ActionBlockDefinition {
  id               String  @id @default(cuid())
  key              String  @unique
  name             String
  category         String // trigger | action | data | logic | ui
  description      String?
  configSchema     Json    @default("[]") // список полей формы настроек: [{name,label,type}]
  tablesUsed       String[] // какие таблицы БД задействует при исполнении
  menuLabel        String? // если блок = пункт меню в опубликованном приложении
  frontendComponent String // card-form-list | report-table | run-button | none
}

// Запись исполнения workflow
model WorkflowRun {
  id         String    @id @default(cuid())
  workflowId String
  workflow   Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status     String // running | success | error
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  steps WorkflowRunStep[]
}

// Шаг исполнения одного блока действия в рамках прогона
model WorkflowRunStep {
  id         String      @id @default(cuid())
  runId      String
  run        WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stageNodeId String
  nodeId     String
  blockKey   String
  input      Json?
  output     Json?
  status     String // success | error | skipped
  error      String?
  startedAt  DateTime    @default(now())
  finishedAt DateTime?
}

// Карточка сущности (клиент, счёт, документ, банкет и т.п.) — создаётся блоком data.card
model CardRecord {
  id        String   @id @default(cuid())
  cardType  String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Связь между двумя карточками — создаётся блоком data.relation
model CardRelation {
  id           String   @id @default(cuid())
  sourceCardId String
  targetCardId String
  label        String?
  createdAt    DateTime @default(now())
}

// Напоминание — создаётся блоком logic.reminder (без фактической доставки в MVP)
model Reminder {
  id        String   @id @default(cuid())
  cardId    String?
  dueAt     DateTime
  message   String
  createdAt DateTime @default(now())
}

// Исходящее сообщение — создаётся блоком action.sendEmail (симуляция в MVP, реальный SMTP не подключен)
model OutboundMessage {
  id        String   @id @default(cuid())
  channel   String // email
  to        String
  subject   String?
  body      String
  status    String // simulated
  createdAt DateTime @default(now())
}

// Сгенерированный файл (PDF и т.п.) — создаётся блоком action.generatePdf
model GeneratedFile {
  id         String   @id @default(cuid())
  name       String
  mimeType   String
  dataBase64 String
  createdAt  DateTime @default(now())
}
