# Подключение к базе данных
DATABASE_URL=postgresql://revolit:revolit@db:5432/revolit

# Внешний адрес программы (для ссылок в письмах)
APP_URL=http://localhost:3210

# Почта. Локально письма ловит перехватчик MailHog (mail:1025).
# На сервере: smtp.hoster.ru, порт 465, SSL, ящик info@revolit.ru
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Revolit <no-reply@revolit.local>

# Как приложение работает с базой (Р-45): bus (по умолчанию) — через шину и агента,
# direct — напрямую, без RabbitMQ и агента (compose-файл docker-compose.direct.yml).
# Выбирается при развёртывании, не из админки.
# DATA_MODE=bus
BUS_URL=amqp://revolit:revolit@rabbitmq:5672

# Срок жизни кэша проверенной сессии в памяти процесса, мс. 0 — кэш выключен.
# Необязательно, по умолчанию 15000 (15 секунд).
# SESSION_CACHE_TTL_MS=15000

# Пауза агента перед подпиской на очередь при каждом (пере)старте, мс. 0 — не ждать.
# В docker-compose.prod.yml у поставляемого агента по умолчанию 5000 — переопределяется здесь.
# AGENT_STARTUP_GRACE_MS=5000

# Оповещения о состоянии шины (Раздел «Настройки → Шина», Р-44) — через Telegram-бота.
# Необязательно: без значений оповещения просто не отправляются.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
