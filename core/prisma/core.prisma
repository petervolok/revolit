// Программа — отдельная собранная система со своими пользователями, ролями и данными
model Program {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  roles     Role[]
  auditLogs AuditLog[]
  settings        ProgramSettings?
  moduleToggles   ModuleToggle[]
  aiKeyGroups     AiKeyGroup[]
}

// Роль = рабочее место. Описывается в конструкторе, назначается людям в самой программе.
model Role {
  id          String   @id @default(cuid())
  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  key         String
  name        String
  description String?
  permissions String[] @default([])
  // Системные роли нельзя удалить из интерфейса программы
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserRole[]

  @@unique([programId, key])
}

model User {
  id           String  @id @default(cuid())
  programId    String
  program      Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  email        String
  name         String
  passwordHash String

  isActive           Boolean @default(true)
  mustChangePassword Boolean @default(false)

  // Защита от подбора пароля
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  roles       UserRole[]
  sessions    Session[]
  loginCodes  LoginCode[]
  resetTokens PasswordResetToken[]

  @@unique([programId, email])
}

model UserRole {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([userId, roleId])
}

// Активные сессии. В базе только хеш токена — сам токен живёт лишь в cookie у пользователя.
model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  lastSeenAt DateTime @default(now())
  ip        String?
  userAgent String?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Одноразовый код второго фактора, отправляемый на почту
model LoginCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Журнал действий: кто, что и когда сделал
model AuditLog {
  id         String   @id @default(cuid())
  programId  String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  userId     String?
  actorEmail String?
  action     String
  target     String?
  targetId   String?
  details    Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([programId, createdAt])
}

// ─── Механизм сущностей ───
// Расширение на данных: применяется мгновенно, без пересборки (Р-19).
// Поэтому запись хранится не отдельной таблицей, а строкой с JSON-содержимым.

model EntityTemplate {
  id         String   @id @default(cuid())
  programId  String
  // Техническое имя: латиница, используется в адресе раздела
  key        String
  name       String
  namePlural String
  // Ключ шаблона, из которого создана сущность — нужен только для того, чтобы
  // связи между шаблонами находили друг друга при создании (Р-29). Дальнейшую
  // жизнь сущности никак не ограничивает.
  sourcePresetKey String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fields  EntityField[]
  records EntityRecord[]

  @@unique([programId, key])
}

// Шаблон сущности — готовый набор полей на выбор при создании (Р-29).
// Хранится как данные, а не в коде — так шаблоны можно редактировать
// в интерфейсе, тем же приёмом, что и сами сущности (Р-19).
model EntityTemplatePreset {
  id         String   @id @default(cuid())
  programId  String
  key        String
  name       String
  namePlural String
  // Список полей целиком одним полем: у пресета нет ни записей, ни правил
  // блокировки — хранить его строками, как EntityField, незачем.
  fields     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([programId, key])
}

model EntityField {
  id         String         @id @default(cuid())
  templateId String
  template   EntityTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key        String
  label      String
  // text | number | date | select | relation
  type       String
  required   Boolean        @default(false)
  // Для select — { choices: string[] }; для relation — { targetTemplateId: string }
  options    Json?
  order      Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([templateId, key])
}

model EntityRecord {
  id         String         @id @default(cuid())
  programId  String
  templateId String
  template   EntityTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  data       Json
  // Признак чувствительности (ТЗ переработки ядра, 4.2): вычисляет агент по
  // SensitivityRule при создании/изменении записи; по JSON `data` фильтровать
  // в репликации нельзя, поэтому признак вынесен в отдельное поле
  sensitive  Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  // Дела процессов, заведённые по этой записи (Р-36) — необязательная связь,
  // запись живёт независимо от того, привязано к ней дело или нет
  linkedInstances ProcessInstance[]
  // Задачи, заведённые по этой записи (Р-37) — той же необязательной связью
  linkedTasks     Task[]
  attachments     Attachment[]

  @@index([templateId, createdAt])
}

// ─── Настройки программы ───
// Первый кусочек общих настроек (Р-25): пока только почта. Шаг 8 добавит
// остальное на ту же таблицу — адрес, оформление, хранилище.

model ProgramSettings {
  id         String   @id @default(cuid())
  programId  String   @unique
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  mailHost   String?
  mailPort   Int?
  mailSecure Boolean  @default(false)
  mailUser   String?
  mailPass   String?
  mailFrom   String?
  // Адрес, по которому программа доступна извне — для ссылок в письмах (Р-28)
  appUrl     String?
  // Лицензионный ключ целиком — подписанные данные, проверяются на лету,
  // ничего из содержимого отдельно не хранится (Р-30)
  licenseKey String?
  // Активная группа ключей ИИ-консультанта (Р-35) — не внешний ключ на уровне
  // базы, чтобы не тащить обязательную связь в обе стороны; принадлежность
  // группы той же программе проверяется в сервисе
  activeAiGroupId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Группы ключей ИИ-консультанта ───
// Несколько ключей можно объединить в группу (Р-35): если у активного ключа
// кончился лимит, система автоматически пробует следующий ключ внутри той же
// группы по порядку — клиент не должен вручную менять ключ на середине дня.

model AiKeyGroup {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String
  provider  String
  model     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  keys AiKey[]

  @@unique([programId, name])
}

model AiKey {
  id        String     @id @default(cuid())
  groupId   String
  group     AiKeyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // Сам ключ — пишется, никогда не возвращается клиенту целиком (Р-33)
  apiKey    String
  label     String?
  order     Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([groupId, order])
}

// ─── Конструктор процессов ───
// Линейная структура, не свободный холст: Процесс → Этапы по порядку.
// «Блок действия» — пункт чек-листа этапа, не исполняемый код (Р-32).

model ProcessTemplate {
  id        String   @id @default(cuid())
  programId String
  key       String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages    ProcessStage[]
  instances ProcessInstance[]

  @@unique([programId, key])
}

model ProcessStage {
  id         String          @id @default(cuid())
  templateId String
  template   ProcessTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  order      Int             @default(0)
  name       String
  // Кто отвечает за этап — текстом, не ссылка на роль входа (Р-32)
  responsible String?
  regulation String?
  // Список действий этапа: [{ "label": "..." }]
  checklist  Json            @default("[]")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

// Дело — экземпляр процесса, проходящий через этапы
model ProcessInstance {
  id         String          @id @default(cuid())
  programId  String
  templateId String
  template   ProcessTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title      String
  currentStageId String
  status     String          @default("active") // active | done | cancelled
  // Отметки по чек-листу: { "<stageId>": { "0": true, "1": false } }
  checklistState Json        @default("{}")
  // Необязательная связь с записью сущности (Р-36) — дело можно завести
  // без привязки; если запись удалили, дело остаётся, просто теряет ссылку
  entityRecordId String?
  entityRecord   EntityRecord?   @relation(fields: [entityRecordId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  history ProcessHistoryEntry[]
  tasks   Task[]
  attachments Attachment[]

  @@index([templateId, status])
  @@index([entityRecordId])
}

// ─── Витрина плагинов ───
// Модули уже «зашиты» в сборку (Р-34) — витрина не скачивает код, а только
// включает/выключает то, что уже есть. Отсутствие строки = модуль включён
// (по умолчанию доступно всё установленное).
model ModuleToggle {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  moduleKey String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([programId, moduleKey])
}

// След перехода дела между этапами — видимая история, не журнал действий
model ProcessHistoryEntry {
  id          String          @id @default(cuid())
  instanceId  String
  instance    ProcessInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  fromStageId String?
  toStageId   String
  actorEmail  String?
  note        String?
  createdAt   DateTime        @default(now())

  @@index([instanceId, createdAt])
}

// ─── Задачи ───
// Личные задачи сотрудника, необязательно привязанные к записи сущности
// или делу процесса (Р-37) — не автоматика, напоминание держится на том,
// что сотрудник сам открывает раздел «Задачи» и видит просроченное.

model Task {
  id          String   @id @default(cuid())
  programId   String
  title       String
  description String?
  assigneeId  String?
  createdById String?
  dueAt       DateTime?
  status      String   @default("open") // open | done
  doneAt      DateTime?

  // Необязательная связь с записью или делом — тем же приёмом, что и Р-36
  entityRecordId   String?
  entityRecord     EntityRecord?    @relation(fields: [entityRecordId], references: [id], onDelete: SetNull)
  processInstanceId String?
  processInstance  ProcessInstance? @relation(fields: [processInstanceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments Attachment[]

  @@index([programId, assigneeId, status])
  @@index([entityRecordId])
  @@index([processInstanceId])
}

// ─── Вложения ───
// Файл хранится через сменную часть StoragePort (по умолчанию — на диске
// сервера, core/ports/storage.ts) — облачное хранилище подключается заменой
// порта, остальной код не меняется (Р-38). Привязка ровно к одному
// родителю — записи, делу или задаче; при удалении родителя вложение
// удаляется вместе с ним (не как мягкая связь Р-36/Р-37, у файла нет
// смысла существовать без хозяина).

model Attachment {
  id         String   @id @default(cuid())
  programId  String
  storageKey String
  fileName   String
  mimeType   String
  size       Int
  uploadedById String?

  entityRecordId    String?
  entityRecord      EntityRecord?    @relation(fields: [entityRecordId], references: [id], onDelete: Cascade)
  processInstanceId String?
  processInstance   ProcessInstance? @relation(fields: [processInstanceId], references: [id], onDelete: Cascade)
  taskId            String?
  task              Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([entityRecordId])
  @@index([processInstanceId])
  @@index([taskId])
}

// ─── Правила чувствительности ───
// Конфигурация, а не код (ТЗ переработки ядра, 4.1): директор меняет правила без
// участия разработчика. Условия — JSON вида [{ "field": "...", "op": "eq", "value": ... }];
// запись чувствительна, если выполняются ВСЕ условия хотя бы одного включённого правила
// её сущности. programId — без @relation, как у моделей плагинов (см. 10-plugin-authoring.md).

model SensitivityRule {
  id          String   @id @default(cuid())
  programId   String
  templateKey String
  name        String
  conditions  Json
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([programId, templateKey])
}

// ─── Фоновые задачи ───
// Расписание для планировщика (ТЗ 7). Сам раннер живёт в apps/agent (этап 7);
// здесь только данные: что и как часто запускать.

model ScheduledJob {
  id             String    @id @default(cuid())
  programId      String
  key            String
  cronExpression String
  lastRunAt      DateTime?
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([programId, key])
}
